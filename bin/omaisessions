#!/usr/bin/env python3
"""omAiSessions helper: finds coding-agent conversations and reopens them.

Every command prints a single JSON object on stdout. Failures print
{"ok": false, "error": "..."} and exit non-zero, so the QML side can show the
message without parsing stderr.

  omaisessions list [--limit N]          every known session, newest first
  omaisessions open <agent> <id> <cwd>   resume a session in a terminal in <cwd>,
                                         or focus its window if it is running

Agents keep their history per folder, in their own internal formats, so each
one gets a small reader below. Readers only extract what the panel shows
(title, folder, last activity); results are cached by file mtime and size, so
a refresh only re-reads the files that changed.
"""

import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

CACHE_VERSION = 2
HOME = Path.home()
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "omaisessions"
CACHE_FILE = CACHE_DIR / "index.json"
PROC = Path(os.environ.get("OMAISESSIONS_PROC") or "/proc")

# Session ids end up on a command line; only accept what the agents generate.
SESSION_ID = re.compile(r"^[0-9A-Za-z][0-9A-Za-z_-]{7,63}$")
TITLE_LIMIT = 120


def out(obj, code=0):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.exit(code)


def fail(message):
    out({"ok": False, "error": message}, 1)


def one_line(text):
    text = " ".join(str(text).split())
    return text if len(text) <= TITLE_LIMIT else text[: TITLE_LIMIT - 1].rstrip() + "…"


def is_noise(text):
    # Slash commands, command output, injected context and caveats are all
    # wrapped in pseudo-XML tags; none of them is something the user typed.
    t = text.lstrip()
    return t == "" or t.startswith("<") or t.startswith("Caveat:") or t.startswith("# AGENTS.md")


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for part in content:
            if isinstance(part, dict) and part.get("type") in ("text", "input_text"):
                return part.get("text") or ""
    return ""


def read_lines(path):
    with open(path, "rb") as f:
        for raw in f:
            yield raw


def loads(raw):
    try:
        return json.loads(raw)
    except ValueError:
        return None


def iso_epoch(value):
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


# ------------------------------------------------------------------ processes


def proc_start(pid):
    """Start time of a process in clock ticks since boot (field 22 of stat)."""
    try:
        stat = (PROC / str(pid) / "stat").read_text()
        return stat[stat.rindex(")") + 2 :].split()[19]
    except (OSError, ValueError, IndexError):
        return None


def alive(pid, start=None):
    # A recorded start time guards against a recycled pid.
    now = proc_start(pid)
    return now is not None and (start is None or str(start) == now)


def proc_argv(pid):
    try:
        return [a for a in (PROC / str(pid) / "cmdline").read_bytes().decode("utf-8", "replace").split("\0") if a]
    except OSError:
        return []


def proc_fds(pid):
    targets = []
    try:
        for fd in (PROC / str(pid) / "fd").iterdir():
            try:
                targets.append(os.readlink(fd))
            except OSError:
                pass
    except OSError:
        pass
    return targets


def proc_parent(pid):
    try:
        stat = (PROC / str(pid) / "stat").read_text()
        return int(stat[stat.rindex(")") + 2 :].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def is_program_path(arg):
    # Only a program path identifies a process. Matching words anywhere in
    # argv would also catch a shell whose script merely mentions an agent.
    return arg != "" and not any(c.isspace() for c in arg)


def program_is(argv, name):
    return bool(argv) and is_program_path(argv[0]) and os.path.basename(argv[0]) == name


def all_pids():
    me = os.getpid()
    for entry in PROC.iterdir():
        if entry.name.isdigit() and int(entry.name) != me:
            yield int(entry.name)


# --------------------------------------------------------------- Claude Code


class Claude:
    id = "claude"
    name = "Claude Code"
    binary = "claude"

    def __init__(self):
        self.config = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
        self.root = self.config / "projects"

    def files(self):
        # Top-level <project>/<uuid>.jsonl only; subagent transcripts live in
        # <project>/<uuid>/subagents/ and are not resumable on their own.
        if not self.root.is_dir():
            return []
        return [p for p in self.root.glob("*/*.jsonl") if p.is_file()]

    def read(self, path):
        sid = path.stem
        cwd = branch = None
        custom = ai = first = None
        for raw in read_lines(path):
            if cwd is None and b'"cwd"' in raw:
                entry = loads(raw)
                if entry and entry.get("cwd"):
                    cwd = entry["cwd"]
                    branch = entry.get("gitBranch")
            if b'"custom-title"' in raw:
                entry = loads(raw)
                if entry and entry.get("type") == "custom-title" and entry.get("customTitle"):
                    custom = entry["customTitle"]
            elif b'"ai-title"' in raw:
                entry = loads(raw)
                if entry and entry.get("type") == "ai-title" and entry.get("aiTitle"):
                    ai = entry["aiTitle"]
            elif first is None and b'"type":"user"' in raw:
                entry = loads(raw)
                if entry and entry.get("type") == "user" and not entry.get("isMeta") and not entry.get("isSidechain"):
                    text = text_of((entry.get("message") or {}).get("content"))
                    if not is_noise(text):
                        first = text
        # A file with no real prompt is a cleared or aborted start: nothing to resume.
        if first is None or not cwd:
            return None
        # Claude records "HEAD" outside a branch (detached, or not a repo).
        branch = "" if not branch or branch == "HEAD" else branch
        return {"id": sid, "cwd": cwd, "branch": branch, "title": one_line(custom or ai or first)}

    def running(self):
        # Every interactive claude writes sessions/<pid>.json with the session
        # it is on, kept current across /clear and /resume.
        found = {}
        for f in (self.config / "sessions").glob("*.json"):
            entry = loads(f.read_bytes()) if f.is_file() else None
            if entry and entry.get("sessionId") and alive(entry.get("pid", 0), entry.get("procStart")):
                found[entry["sessionId"]] = (int(entry["pid"]), entry.get("cwd"))
        return found

    def matches(self, argv):
        return program_is(argv, "claude")

    def command(self, sid):
        return [self.binary, "--resume", sid]


# --------------------------------------------------------------------- Codex


class Codex:
    id = "codex"
    name = "Codex"
    binary = "codex"

    def __init__(self):
        self.home = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
        self.root = self.home / "sessions"
        self._names = None

    def files(self):
        if not self.root.is_dir():
            return []
        return [p for p in self.root.glob("*/*/*/rollout-*.jsonl") if p.is_file()]

    def names(self):
        # session_index.jsonl is append-only: the last thread_name per id wins.
        if self._names is None:
            self._names = {}
            index = self.home / "session_index.jsonl"
            if index.is_file():
                for raw in read_lines(index):
                    entry = loads(raw)
                    if entry and entry.get("id") and entry.get("thread_name"):
                        self._names[entry["id"]] = entry["thread_name"]
        return self._names

    def read(self, path):
        meta = first = None
        for raw in read_lines(path):
            if meta is None:
                entry = loads(raw)
                if not entry or entry.get("type") != "session_meta":
                    return None
                meta = entry.get("payload") or {}
                # `codex exec` runs are hidden from `codex resume` by default.
                if meta.get("source") == "exec":
                    return None
                continue
            if b'"role":"user"' in raw:
                entry = loads(raw)
                payload = (entry or {}).get("payload") or {}
                if payload.get("type") == "message" and payload.get("role") == "user":
                    text = text_of(payload.get("content"))
                    if not is_noise(text):
                        first = text
                        break
        if not meta or not meta.get("id") or not meta.get("cwd") or first is None:
            return None
        git = meta.get("git") or {}
        # The title is resolved on every list (names can change without the
        # rollout file changing), so only the fallback is cached.
        return {"id": meta["id"], "cwd": meta["cwd"], "branch": git.get("branch") or "", "title": one_line(first)}

    def title(self, session):
        name = self.names().get(session["id"])
        return one_line(name) if name else session["title"]

    def running(self):
        return {}  # no registry; found through open files (see find_running)

    def session_for_fd(self, target):
        # Current Codex runs sessions in a `codex app-server` daemon, which
        # holds thread-writer-locks/<id>.lock for each loaded session, even
        # before the first prompt creates its rollout file.
        if os.path.dirname(target) == str(self.home / "thread-writer-locks") and target.endswith(".lock"):
            sid = os.path.basename(target)[: -len(".lock")]
            return sid if SESSION_ID.match(sid) else None
        return None

    def owns(self, pid):
        # A client uses the sessions of its own CODEX_HOME; another one's
        # (a second profile, or a test) is not ours to pair it with.
        try:
            env = dict(e.split("=", 1) for e in (PROC / str(pid) / "environ").read_bytes().decode("utf-8", "replace").split("\0") if "=" in e)
        except OSError:
            return True
        home = env.get("CODEX_HOME") or os.path.join(env.get("HOME") or str(HOME), ".codex")
        return os.path.realpath(home) == os.path.realpath(self.home)

    def is_server(self, argv):
        # `codex app-server ...`: the session server and its updater.
        return len(argv) > 1 and argv[1] == "app-server"

    def matches(self, argv):
        return program_is(argv, "codex")

    def command(self, sid):
        return [self.binary, "resume", sid]


# ---------------------------------------------------------------------- Grok


class Grok:
    id = "grok"
    name = "Grok"
    binary = "grok"

    def __init__(self):
        self.home = Path(os.environ.get("GROK_HOME") or HOME / ".grok")
        self.root = self.home / "sessions"

    def files(self):
        # sessions/<url-encoded cwd>/<id>/summary.json; subagents nest deeper.
        if not self.root.is_dir():
            return []
        return [p for p in self.root.glob("*/*/summary.json") if p.is_file()]

    def first_prompt(self, folder, sid):
        history = folder / "prompt_history.jsonl"
        if history.is_file():
            for raw in read_lines(history):
                if sid.encode() in raw:
                    entry = loads(raw)
                    if entry and entry.get("session_id") == sid and not entry.get("is_bash") and not is_noise(entry.get("prompt") or ""):
                        return entry["prompt"]
        # Older sessions predate prompt_history: what was typed is the
        # <user_query> inside a user message, after the injected context.
        chat = folder / sid / "chat_history.jsonl"
        if chat.is_file():
            for raw in read_lines(chat):
                if b"<user_query>" in raw:
                    entry = loads(raw)
                    if entry and entry.get("type") == "user":
                        m = re.search(r"<user_query>\s*(.*?)\s*(?:</user_query>|$)", text_of(entry.get("content")), re.S)
                        if m and m.group(1):
                            return m.group(1)
        return None

    def read(self, path):
        summary = loads(path.read_bytes()) or {}
        info = summary.get("info") or {}
        sid = info.get("id") or path.parent.name
        cwd = info.get("cwd")
        if not cwd or not summary.get("num_chat_messages", 1):
            return None
        title = (summary.get("title") or summary.get("generated_title") or summary.get("session_summary")
                 or self.first_prompt(path.parent.parent, sid))
        if not title:
            return None
        session = {"id": sid, "cwd": cwd, "branch": "", "title": one_line(title)}
        updated = iso_epoch(summary.get("last_active_at") or summary.get("updated_at") or "")
        if updated:
            session["updated"] = updated
        return session

    def running(self):
        found = {}
        entries = loads((self.home / "active_sessions.json").read_bytes()) if (self.home / "active_sessions.json").is_file() else None
        for entry in entries if isinstance(entries, list) else []:
            if entry.get("session_id") and alive(entry.get("pid", 0), entry.get("pid_start")):
                found[entry["session_id"]] = (int(entry["pid"]), entry.get("cwd"))
        return found

    def matches(self, argv):
        # The launcher execs a versioned binary (grok-1.0.62); Grok Bot is a
        # different app and must not count.
        return program_is(argv, "grok") or (bool(argv) and re.fullmatch(r"grok-[0-9][0-9.]*", os.path.basename(argv[0])) is not None)

    def command(self, sid):
        return [self.binary, "--resume", sid]


# ---------------------------------------------------------------- Cursor CLI


# Absolute paths inside Cursor's blobs (protobuf or JSON): candidates for the
# chat's folder, confirmed against the md5 in the chat's directory name.
PATH_IN_BLOB = re.compile(rb"/(?:[^\x00-\x20\"'<>\\]+)")


def md5_path(path):
    return hashlib.md5(path.encode("utf-8", "surrogateescape")).hexdigest()


class Cursor:
    id = "cursor"
    name = "Cursor"
    binary = "cursor-agent"

    def roots(self):
        # Same lookup as cursor-agent: CURSOR_CONFIG_DIR, else
        # $XDG_CONFIG_HOME/cursor, else ~/.cursor. The bar may not share the
        # terminal's XDG_CONFIG_HOME, so both defaults are checked.
        dirs = []
        if os.environ.get("CURSOR_CONFIG_DIR", "").strip():
            dirs.append(Path(os.environ["CURSOR_CONFIG_DIR"]))
        dirs += [Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "cursor", HOME / ".config" / "cursor", HOME / ".cursor"]
        seen, result = set(), []
        for d in dirs:
            chats = d / "chats"
            if chats.is_dir() and chats.resolve() not in seen:
                seen.add(chats.resolve())
                result.append(chats)
        return result

    def files(self):
        # chats/<md5 of the folder>/<chat id>/store.db
        return [p for root in self.roots() for p in root.glob("*/*/store.db") if p.is_file()]

    def read(self, path):
        folder_hash = path.parent.parent.name
        try:
            db = sqlite3.connect("file:" + str(path) + "?mode=ro", uri=True, timeout=1)
        except sqlite3.Error:
            return None
        try:
            row = db.execute("SELECT value FROM meta WHERE key = '0'").fetchone()
            meta = loads(bytes.fromhex(row[0])) if row and row[0] else None
            meta = meta if isinstance(meta, dict) else {}
            cwd = first = None
            for (data,) in db.execute("SELECT data FROM blobs"):
                if not isinstance(data, bytes):
                    continue
                if cwd is None:
                    for m in PATH_IN_BLOB.finditer(data):
                        cwd = self.match_folder(m.group().decode("utf-8", "replace"), folder_hash)
                        if cwd:
                            break
                if first is None and b'"role":"user"' in data:
                    first = self.user_text(data)
                if cwd and first:
                    break
        except (sqlite3.Error, ValueError):
            return None
        finally:
            db.close()
        name = meta.get("name") if meta.get("name") not in (None, "", "New Agent", "New Chat") else None
        title = name or first
        if not title:
            return None
        # cwd stays None when no blob names it; resolve_cursor_folders fills it.
        return {"id": path.parent.name, "cwd": cwd, "branch": "", "title": one_line(title), "folderHash": folder_hash}

    @staticmethod
    def match_folder(path, folder_hash):
        # The folder, or a file inside it: walk up until the md5 matches.
        p = path.rstrip("/.,;:)")
        while p and p != "/":
            if md5_path(p) == folder_hash:
                return p
            p = os.path.dirname(p)
        return None

    @staticmethod
    def user_text(data):
        message = loads(data)
        if not isinstance(message, dict) or message.get("role") != "user":
            return None
        text = text_of(message.get("content"))
        # The CLI wraps what you typed in <user_query> after injected context.
        m = re.search(r"<user_query>\s*(.*?)\s*</user_query>", text, re.S)
        if m:
            text = m.group(1)
        return None if is_noise(text) else text

    def running(self):
        return {}  # found through the open store.db (see find_running)

    def matches(self, argv):
        # The CLI runs as `node <install>/cursor-agent/<version>/.../index.js`.
        return program_is(argv, "cursor-agent") or (
            len(argv) > 1 and is_program_path(argv[1]) and "/cursor-agent/" in argv[1] and argv[1].endswith(".js"))

    def command(self, sid):
        return [self.binary, "--resume", sid]


AGENTS = {a.id: a for a in (Claude(), Codex(), Grok(), Cursor())}


def resolve_cursor_folders(sessions, known, cache_paths):
    """Fill in Cursor folders that their blobs didn't reveal.

    Cursor names a chat's directory after the md5 of its folder, so any folder
    that hashes the same is the answer: try every folder the other agents
    know about, then the home directory a few levels deep.
    """
    pending = [s for s in sessions if s["agent"] == "cursor" and not s.get("cwd")]
    if not pending:
        return
    def candidates():
        yield from cache_paths.values()
        yield from known
        yield str(HOME)
        for top, dirs, _ in os.walk(HOME):
            depth = top[len(str(HOME)):].count(os.sep)
            dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "target", "venv")]
            if depth >= 3:
                dirs[:] = []
            yield top
    want = {s["folderHash"] for s in pending}
    for path in candidates():
        h = md5_path(path)
        if h in want:
            cache_paths[h] = path
            want.discard(h)
            if not want:
                break
    for s in pending:
        s["cwd"] = cache_paths.get(s["folderHash"])


def find_running(sessions):
    """Map (agent, session id) -> (pid, cwd) for every session open right now.

    Claude and Grok keep a registry of live sessions. Otherwise a live agent
    process either names the session id on its command line (`codex resume
    <id>`), has the session's file open, is attached to a session server
    that holds the session's lock (current Codex), or, failing all of
    those, is taken to be on the newest session in its folder that it has
    written to. The cwd is known for registry and lock matches; it places a
    session that has no history yet.
    """
    running = {}
    for agent in AGENTS.values():
        for sid, (pid, cwd) in agent.running().items():
            running[(agent.id, sid)] = (pid, cwd)

    by_path = {s["_path"]: s for s in sessions}
    dirs = {os.path.dirname(p): s for p, s in by_path.items() if s["agent"] in ("cursor", "grok")}
    ids = {(s["agent"], s["id"]) for s in sessions}
    cwds = {(s["agent"], s["id"]): s["cwd"] for s in sessions}
    claimed = {pid for pid, _ in running.values()}
    tick = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
    boot = time.time() - float((PROC / "uptime").read_text().split()[0]) if (PROC / "uptime").exists() else 0

    def cwd_of(pid):
        try:
            return os.readlink(PROC / str(pid) / "cwd")
        except OSError:
            return None

    # Session servers (Codex's app-server and its updater) outlive the
    # windows they serve and keep closed sessions loaded, so their locks
    # only say which sessions a client may be on; a client is what makes a
    # session running, and its pid leads to the window.
    clients = []
    locks = {}  # agent id -> [(lock mtime, session id)]
    for pid in all_pids():
        argv = proc_argv(pid)
        agent = next((a for a in AGENTS.values() if a.matches(argv)), None)
        if not agent or agent.id in ("claude", "grok") or pid in claimed:
            continue
        if hasattr(agent, "is_server") and agent.is_server(argv):
            for target in proc_fds(pid):
                sid = agent.session_for_fd(target)
                if sid:
                    try:
                        mtime = os.stat(target).st_mtime
                    except OSError:
                        mtime = 0
                    locks.setdefault(agent.id, []).append((mtime, sid))
        else:
            clients.append((pid, agent, argv))

    pending = []
    for pid, agent, argv in clients:
        hit = None
        for arg in argv[1:]:
            if (agent.id, arg) in ids:
                hit = arg
        if hit is None:
            for target in proc_fds(pid):
                s = by_path.get(target) or dirs.get(os.path.dirname(target))
                if s and s["agent"] == agent.id:
                    hit = s["id"]
                    break
        if hit is None:
            pending.append((pid, agent))
        else:
            running.setdefault((agent.id, hit), (pid, None))

    def started_of(pid):
        start = proc_start(pid)
        return boot + int(start) / tick if start and boot else 0

    # Newest client first, so each takes the session it opened last.
    for pid, agent in sorted(pending, key=lambda c: started_of(c[0]), reverse=True):
        cwd = cwd_of(pid)
        started = started_of(pid)
        if hasattr(agent, "owns") and not agent.owns(pid):
            continue
        pool = [(mtime, sid) for mtime, sid in sorted(set(locks.get(agent.id, [])), reverse=True)
                if (agent.id, sid) not in running]
        # A session is locked when a client opens it, so this client is on
        # one locked since it started (the newest, after a /resume): in its
        # folder (a session with history elsewhere is another client's). A
        # lock from before it started belongs to a client that may have
        # closed; only take one in this client's folder.
        since = [sid for mtime, sid in pool if mtime >= started - 2 and cwds.get((agent.id, sid), cwd) == cwd]
        sid = (next((x for x in since if cwds.get((agent.id, x)) == cwd), None) or (since[0] if since else None)
               or next((x for _, x in pool if cwds.get((agent.id, x)) == cwd and (agent.id, x) in ids), None))
        if sid:
            running[(agent.id, sid)] = (pid, cwd)
            continue
        # Fall back to the folder: the newest session there that changed
        # since this process started.
        for s in sessions:  # newest first
            if s["agent"] == agent.id and s["cwd"] == cwd and s["updated"] >= started - 5:
                running.setdefault((agent.id, s["id"]), (pid, None))
                break
    return running


def started_at(pid):
    tick = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
    try:
        boot = time.time() - float((PROC / "uptime").read_text().split()[0])
        return int(boot + int(proc_start(pid)) / tick)
    except (OSError, ValueError, TypeError):
        return int(time.time())


# --------------------------------------------------------------------- cache


def load_cache():
    try:
        with open(CACHE_FILE, encoding="utf-8") as f:
            data = json.load(f)
        if data.get("version") == CACHE_VERSION and isinstance(data.get("files"), dict):
            return data["files"], data.get("paths") if isinstance(data.get("paths"), dict) else {}
    except (OSError, ValueError):
        pass
    return {}, {}


def save_cache(files, paths):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=CACHE_DIR, prefix=".index.")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"version": CACHE_VERSION, "files": files, "paths": paths}, f, ensure_ascii=False, separators=(",", ":"))
        os.replace(tmp, CACHE_FILE)
    except OSError:
        pass  # a missing cache only costs speed


def stamp(path):
    # SQLite in WAL mode writes to <db>-wal first; include it so a Cursor
    # chat counts as changed before its checkpoint.
    mtime = size = 0
    for p in (path, Path(str(path) + "-wal")):
        try:
            st = p.stat()
        except OSError:
            continue
        mtime, size = max(mtime, st.st_mtime_ns), size + st.st_size
    return mtime, size


# ------------------------------------------------------------------ commands


def collect():
    cache, paths = load_cache()
    fresh = {}
    sessions = []
    agents = []

    for agent in AGENTS.values():
        for path in agent.files():
            mtime, size = stamp(path)
            if not mtime:
                continue
            key = str(path)
            hit = cache.get(key)
            if hit and hit.get("mtime") == mtime and hit.get("size") == size:
                session = hit.get("session")
            else:
                try:
                    session = agent.read(path)
                except OSError:
                    continue
            fresh[key] = {"mtime": mtime, "size": size, "session": session}
            if not session:
                continue
            item = dict(session)
            if hasattr(agent, "title"):
                item["title"] = agent.title(session)
            item["agent"] = agent.id
            item["updated"] = int(session.get("updated") or mtime / 1e9)
            item["_path"] = key
            sessions.append(item)

    known = {s["cwd"] for s in sessions if s.get("cwd")}
    cached_paths = dict(paths)
    resolve_cursor_folders(sessions, known, paths)
    sessions = [s for s in sessions if s.get("cwd")]
    sessions.sort(key=lambda s: s["updated"], reverse=True)

    if fresh != cache or paths != cached_paths:
        save_cache(fresh, paths)

    running = find_running(sessions)
    listed = {(s["agent"], s["id"]) for s in sessions}
    for s in sessions:
        pid, _ = running.get((s["agent"], s["id"]), (None, None))
        s["running"] = pid is not None
        if pid:
            s["pid"] = pid
    # A running session with no history yet (no prompt sent) has nothing to
    # resume, but it is open in a window that can be switched to.
    for (agent_id, sid), (pid, cwd) in running.items():
        if (agent_id, sid) not in listed and cwd:
            sessions.append({"id": sid, "cwd": cwd, "branch": "", "title": "New session", "new": True,
                             "agent": agent_id, "updated": started_at(pid), "running": True, "pid": pid})
    sessions.sort(key=lambda s: s["updated"], reverse=True)
    for s in sessions:
        s["exists"] = os.path.isdir(s["cwd"])

    for agent in AGENTS.values():
        mine = [s for s in sessions if s["agent"] == agent.id]
        agents.append({
            "id": agent.id,
            "name": agent.name,
            "installed": shutil.which(agent.binary) is not None,
            "count": len(mine),
            "running": sum(1 for s in mine if s["running"]),
        })
    return agents, sessions


def public(session):
    return {k: v for k, v in session.items() if not k.startswith("_") and k != "folderHash"}


def cmd_list(args):
    limit = 0
    if args[:1] == ["--limit"]:
        if len(args) < 2 or not args[1].isdigit():
            fail("--limit needs a number")
        limit = int(args[1])
    agents, sessions = collect()
    if limit:
        sessions = sessions[:limit]
    out({"ok": True, "home": str(HOME), "generated": int(time.time()), "agents": agents,
         "sessions": [public(s) for s in sessions]})


def window_for(pid):
    """Hyprland window address of the terminal an agent runs in, if any."""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    windows = {c.get("pid"): c.get("address") for c in clients if c.get("address")}
    seen = set()
    while pid > 1 and pid not in seen:
        if pid in windows:
            return windows[pid]
        seen.add(pid)
        pid = proc_parent(pid)
    return None


def focus(address):
    # Lua dispatch on current Hyprland; the classic dispatcher otherwise.
    for cmd in (["hyprctl", "dispatch", 'hl.dsp.focus({ window = "address:%s" })' % address],
                ["hyprctl", "dispatch", "focuswindow", "address:" + address]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0 and "error" not in (r.stdout + r.stderr).lower():
            return True
    return False


def cmd_open(args):
    if len(args) != 3:
        fail("usage: open <agent> <id> <cwd>")
    agent_id, sid, cwd = args
    agent = AGENTS.get(agent_id)
    if not agent:
        fail("Unknown agent: " + agent_id)
    if not SESSION_ID.match(sid):
        fail("Invalid session id")

    # Two agents writing one session corrupts it: a running session gets its
    # window focused instead of a second copy.
    _, sessions = collect()
    current = next((s for s in sessions if s["agent"] == agent_id and s["id"] == sid), None)
    if current is None:
        fail("That session is gone: it ended before its first prompt, or its history was deleted")
    if current["running"]:
        address = window_for(current["pid"])
        if address and focus(address):
            out({"ok": True, "focused": True, "message": "Switched to the running session"})
        fail("Already running in another terminal (pid %d) and its window can't be found" % current["pid"])

    if not os.path.isabs(cwd) or not os.path.isdir(cwd):
        fail("Folder no longer exists: " + cwd)
    if shutil.which(agent.binary) is None:
        fail(agent.name + " is not installed (" + agent.binary + " not on PATH)")

    # Same launch path as `omarchy agent`: one app-id for every agent window,
    # so window rules and themes apply to resumed sessions too.
    terminal = ["xdg-terminal-exec", "--app-id=org.omarchy.agent", "--dir=" + cwd, "-e"] + agent.command(sid)
    if shutil.which("uwsm-app"):
        terminal = ["uwsm-app", "--"] + terminal
    try:
        subprocess.Popen(terminal, cwd=cwd, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        fail("Could not start a terminal: " + str(e))
    out({"ok": True, "message": "Resuming in " + cwd})


def main(argv):
    if not argv:
        fail("usage: omaisessions <list|open> ...")
    commands = {"list": cmd_list, "open": cmd_open}
    command = commands.get(argv[0])
    if not command:
        fail("Unknown command: " + argv[0])
    command(argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
