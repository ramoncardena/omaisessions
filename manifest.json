{
  "schemaVersion": 1,
  "id": "io.github.ramoncardena.omaisessions",
  "name": "omAiSessions",
  "version": "0.5.2",
  "author": "Ramon Cardena",
  "license": "MIT",
  "description": "Every Claude Code, Codex, Grok, Cursor and OpenCode conversation on this computer in one bar panel: see which agents are working or need you, and resume any session in the right folder.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "AI Sessions",
    "description": "Browse and resume coding-agent conversations from every folder.",
    "category": "Productivity",
    "defaultSection": "right",
    "aliases": [
      "sessions",
      "claude",
      "codex",
      "grok",
      "cursor",
      "opencode",
      "ai"
    ],
    "allowMultiple": false,
    "defaults": {
      "maxSessions": 200,
      "refreshSeconds": 5,
      "notifyNeedsYou": true
    },
    "schema": [
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Refresh every (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "notifyNeedsYou",
        "type": "boolean",
        "label": "Notify when an agent needs you",
        "defaultValue": true
      },
      {
        "key": "maxSessions",
        "type": "integer",
        "label": "Sessions to show",
        "min": 20,
        "max": 2000,
        "step": 20,
        "defaultValue": 200
      }
    ]
  }
}
